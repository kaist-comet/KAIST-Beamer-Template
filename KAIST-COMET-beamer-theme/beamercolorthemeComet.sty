\definecolor{Espresso}{RGB}{116,59,25}

% color settings
\setbeamercolor{alerted text}{fg=Pitaya}
\setbeamercolor{example text}{fg=Espresso}
\setbeamercolor*{palette primary}{fg=white,bg=KAISTDarkBlue} % main title page
\setbeamercolor*{palette secondary}{fg=KAISTDarkBlue,bg=KAISTLightBlue!20!white} % slide title
\setbeamercolor*{palette tertiary}{fg=white,bg=KAISTDarkBlue} % menu bar
\setbeamercolor*{palette quaternary}{fg=white,bg=KAISTBlue}
\setbeamercolor*{sidebar}{fg=KAISTBlue,bg=KAISTBlue!75!white}

\setbeamercolor*{titlelike}{parent=palette primary}
\setbeamercolor*{frametitle}{fg=KAISTDarkBlue, bg=white} %frametitle
\setbeamercolor*{frametitle right}{parent=palette secondary}

\setbeamercolor*{separation line}{}
\setbeamercolor*{fine separation line}{}

\setbeamercolor*{block title}{parent=palette primary}
\setbeamercolor*{block body}{fg=black, bg=gray!20!white}

\setbeamercolor*{footline}{fg=KAISTDarkBlue, bg=white}

% itemize, enumerate, description ....
\setbeamercolor{item}{fg=KAISTDarkBlue} 

\setbeamercolor{title page background}{bg=KAISTDarkBlue}
\setbeamercolor{title page title}{fg=comettitle}
\setbeamercolor{title page author}{fg=cometauthor}

\setbeamercolor{sectiontitle}{fg=KAISTDarkBlue}
\setbeamercolor{sectionsubtitle}{fg=sectionsubtitlefg}

\setbeamercolor{section in head/foot}{parent=palette tertiary}
\setbeamercolor{kaistlogo in head/foot}{parent=palette secondary}
\setbeamercolor{author in head/foot}{parent=subsection in head/foot}
\setbeamercolor{title in head/foot}{parent=section in head/foot}