
% KAIST color definitions
\definecolor{KAISTDarkBlue}{RGB}{0,65,145}
\definecolor{KAISTMediumBlue}{RGB}{0,65,135}
\definecolor{KAISTBlue}{RGB}{20,135,200}
\definecolor{KAISTLightBlue}{RGB}{95,190,235}
\definecolor{KAISTDarkGray}{RGB}{124,124,124}

% other custom color definitions
\definecolor{comettitle}{HTML}{D9C0AA}
\definecolor{cometauthor}{HTML}{8DA7CD}
\definecolor{sectionbg}{HTML}{c0d2e6}
\definecolor{sectionsubtitlefg}{HTML}{808080}

% some useful color definitions
