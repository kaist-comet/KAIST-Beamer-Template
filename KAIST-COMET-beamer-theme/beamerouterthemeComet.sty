\setbeamertemplate{frametitle}
{
    \begin{beamercolorbox}[wd=\paperwidth, ht=1.8ex, dp=0.5ex, leftskip=0.8cm, sep=0pt]{frametitle}
        \hbox{%
            \usebeamerfont{frametitle}%
            \insertframetitle%
        }
    \end{beamercolorbox}
}

\setbeamertemplate{sectionframetitle}
{
    \vspace{3cm}
    \begin{beamercolorbox}[wd=\paperwidth, ht=3ex, dp=1ex, leftskip=0.5cm, sep=0pt]{frametitle}
        \hbox{%
            \usebeamerfont{frametitle}%
            \insertframetitle
        }
    \end{beamercolorbox}
}

\newenvironment{sectionframe}[2]{
    % Switch to custom template and settings for the section frame
    \setbeamercolor{background canvas}{bg=sectionbg}
    \setbeamercolor{footline}{fg=KAISTDarkBlue, bg=sectionbg}
    \begin{frame}
        \begin{beamercolorbox}[wd=\paperwidth, ht=6ex, dp=1ex, leftskip=0.8cm, rightskip=0.8cm, sep=0pt]{sectiontitle}%
            \parbox{\textwidth}{
                \usebeamerfont{frametitle}%
                #1
            }
        \end{beamercolorbox} %
        \vspace{2cm}
        \begin{beamercolorbox}[wd=\paperwidth, ht=3ex, dp=1ex, leftskip=0.8cm, rightskip=0.8cm, sep=0pt]{sectionsubtitle}%
            \parbox{\textwidth}{
                \usebeamerfont{sectionsubtitle}%
                #2%
            }
        \end{beamercolorbox}             
}{
    \end{frame}
    % Reset frametitle template after the sectionframe is done
}


\mode<presentation>



\defbeamertemplate*{footline}{comet theme}
{
  \leavevmode%
    \hbox{%
