% section frame template
\newenvironment{sectionframe}[2]{
    % Switch to custom template and settings for the section frame
    \setbeamercolor{background canvas}{bg=sectionbg}
    \setbeamercolor{footline}{fg=KAISTDarkBlue, bg=sectionbg}
    \begin{frame}
        \begin{beamercolorbox}[wd=\paperwidth, ht=6ex, dp=1ex, leftskip=0.8cm, rightskip=0.8cm, sep=0pt]{sectiontitle}%
            \parbox{\textwidth}{
                \usebeamerfont{frametitle}%
                #1
            }
        \end{beamercolorbox} %
        \vspace{2cm}
        \begin{beamercolorbox}[wd=\paperwidth, ht=3ex, dp=1ex, leftskip=0.8cm, rightskip=0.8cm, sep=0pt]{sectionsubtitle}%
            \parbox{\textwidth}{
                \usebeamerfont{sectionsubtitle}%
                #2%
            }
        \end{beamercolorbox}             
}{
    \end{frame}
}



% footline template
\defbeamertemplate*{footline}{comet theme}
{
    \leavevmode%
    \hbox{%
        \begin{beamercolorbox}[wd=.333333\paperwidth,ht=2.25ex,dp=1ex,left]{footline}%
            \hspace*{.5cm}     
            {
                \raggedright
                \setlength{\parindent}{0pt}
                \parbox{\dimexpr\paperwidth-2cm\relax}{
                    \includegraphics[height=0.3cm]{logos/KAIST_logo_letters.pdf}
                    \raisebox{-0.05cm}{
                        \includegraphics[height=0.4cm]{logos/comet-logo.pdf} 
                    }
                }
                \par
            }  
        \end{beamercolorbox}%
        \begin{beamercolorbox}[wd=.333333\paperwidth,ht=2.25ex,dp=1ex,center]{footline}%
            %\insertshortdate   
        \end{beamercolorbox}%
        \begin{beamercolorbox}[wd=.333333\paperwidth,ht=2.25ex,dp=1ex,right]{footline}%
            {\usebeamerfont{page number} \insertframenumber{} / \inserttotalframenumber} \hspace*{.5cm}
        \end{beamercolorbox}%
    }%
    \vspace{0.15cm}
}


