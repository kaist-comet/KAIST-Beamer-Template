% macros for various images used in the frame titles
\newcommand\comet{\raisebox{-0.15cm}{\includegraphics[height=0.75cm]{logos/comet-logo-white-bg.pdf}\hspace{0.3cm}}}
\newcommand\nub{\raisebox{-0.25cm}{\includegraphics[height=1cm]{logos/nub.jpg}\hspace{0.3cm}}}
\newcommand\geese{\raisebox{-0.2cm}{\includegraphics[height=1cm]{logos/geese.png}\hspace{0.3cm}}}
