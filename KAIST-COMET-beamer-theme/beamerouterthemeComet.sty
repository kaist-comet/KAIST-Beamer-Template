\def\department{\@dblarg\beamer@department}
\long\def\beamer@department[#1]#2{%
  \def\insertdepartment{#2}%
  \def\beamer@shortdepartment{#1}%
  }
\department[ISE]{Industrial and System Engineering}



\setbeamercolor{section in head/foot}{parent=palette tertiary}
\setbeamercolor{kaistlogo in head/foot}{parent=palette secondary}
\setbeamercolor{author in head/foot}{parent=subsection in head/foot}
\setbeamercolor{title in head/foot}{parent=section in head/foot}

\defbeamertemplate*{title page}{comet theme}

\setbeamertemplate{title page}
{
    \begin{beamercolorbox}[wd=\paperwidth, ht=\paperheight, center, sep=0pt]{title page background}
        \vbox to \paperheight{
                \vspace{0.5cm}
                \setlength{\parindent}{0pt}

                {   
                    \hspace{0.5cm}
                    \raggedright
                    \parbox{\dimexpr\paperwidth-2cm\relax}{
                        \includegraphics[height=0.3cm]{logos/KAIST_logo_letters_light.pdf}
                        \raisebox{-0.05cm}{
                            \includegraphics[height=0.4cm]{logos/comet-logo-light.pdf} 
                        }
                        \usebeamerfont{title page logo}
                        \usebeamercolor[fg]{title page author}
                        \raisebox{0.03cm}{
                            \textbf{C}OMPUTATIONAL \textbf{O}PTIMIZATION \textbf{MET}HODS LAB
                        }
                    }
                    \par
                }
                \vspace{2cm}
                {
                    \hspace{0.3cm}
                    \raggedright
                    \usebeamerfont{title page title}
                    \usebeamercolor[fg]{title page title}
                    \parbox{\dimexpr\paperwidth-2cm\relax}{
                        \inserttitle
                    }
                    \par
                }
                \vspace{1cm}

                {
                    \centering
                    \usebeamerfont{title page author}
                    \usebeamercolor[fg]{title page author}
                        \insertauthor
                    \par \vspace{0.3cm}
                }
            \vfill
        }
    \end{beamercolorbox}
}






